{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=jzlcwnozlzhadatksvgh&features=docs%2Cdatabase%2Cdebugging&read_only=true"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp"
        ]
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "disabled": true
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "disabled": true
      }
    }
  }
}
