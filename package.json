{
  "name": "bureau-des-planques",
  "private": true,
  "version": "0.1.13",
  "stage": "alpha",
  "type": "module",
  "description": "Bureau des Planqués — un TCG Pocket-like satirique dans l'univers corporate",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b",
    "status": "node scripts/status.mjs",
    "simulate": "node scripts/simulate.mjs",
    "capturer": "node scripts/capturer.mjs",
    "icones": "node scripts/icones.mjs",
    "garde-fous": "node scripts/garde-fous.mjs",
    "pesage": "node scripts/pesage.mjs",
    "installer": "node scripts/installer.mjs",
    "isolation": "node scripts/isolation.mjs",
    "mur:import": "node scripts/mur-import.mjs",
    "notes:versions": "node scripts/notes-versions.mjs",
    "plan:dev": "node scripts/plan-dev.mjs",
    "statut": "node scripts/statut-mur.mjs",
    "problemes": "node scripts/problemes-connus.mjs",
    "admin": "node tools/admin/serveur.mjs",
    "serveurs": "node tools/serveurs/serveur.mjs",
    "detect:ui": "impeccable detect src/",
    "detect:ui:page": "node scripts/detect-ui-pages.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"tools/**/*.mjs\" \"supabase/**/*.ts\" \"*.json\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"tools/**/*.mjs\" \"supabase/**/*.ts\" \"*.json\" \"*.ts\"",
    "index:decisions": "node scripts/index-decisions.mjs",
    "ci:etat": "node scripts/ci-etat.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "impeccable": "4.7.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
